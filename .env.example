# ==============================================================================
# DATHEON AUTONOMOUS WHATSAPP LEAD QUALIFICATION & BOOKING PLATFORM
# Environment Configuration Template
# ==============================================================================

# Application & Environment
APP_NAME=Datheon WhatsApp AI Qualification Platform
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Meta WhatsApp Cloud API Credentials
# Note: WHATSAPP_VERIFY_TOKEN is the arbitrary token you specify in Meta App Dashboard
# WHATSAPP_APP_SECRET is your App Secret from Meta App Dashboard -> Basic Settings (Used for HMAC-SHA256 signature verification)
WHATSAPP_VERIFY_TOKEN=your_meta_webhook_verify_token_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_permanent_token_here
WHATSAPP_API_VERSION=v20.0

# Database Persistence
# SQLite used for local dev and testing; PostgreSQL recommended for production: postgresql+asyncpg://user:pass@localhost:5432/datheon_crm
DATABASE_URL=sqlite+aiosqlite:///./datheon_platform.db

# LLM Provider Configuration
# Options: "mock", "ollama", "openai", "gemini"
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Lead Qualification Thresholds
QUALIFICATION_MIN_BUDGET=1000.0
QUALIFICATION_DEFAULT_CURRENCY=USD
QUALIFICATION_MIN_COMPANY_SIZE=5
REQUIRE_DECISION_MAKER=true

# Calendar Integration Configuration
# Options: "mock", "google", "calcom"
CALENDAR_PROVIDER=mock
BUSINESS_TIMEZONE=UTC
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=18:00
MEETING_DURATION_MINUTES=30
MEETING_BUFFER_MINUTES=15
MINIMUM_NOTICE_HOURS=2

# Cal.com & Google Calendar Credentials
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_ID=primary

# CRM Integration Configuration
# Options: "mock", "airtable", "webhook"
CRM_PROVIDER=mock
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads
CRM_WEBHOOK_URL=

# Escalation & Notification Channels
# Options: "mock", "slack", "webhook"
NOTIFICATION_PROVIDER=mock
SLACK_WEBHOOK_URL=
FALLBACK_HUMAN_PHONE=+15550001234
